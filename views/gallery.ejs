<%- include('partials/head', { title: 'Gallery' }) %>
<div class="shell">
  <%- include('partials/sidebar') %>
  <main class="main">
    <%- include('partials/topbar', { pageTitle: 'Gallery', searchAction: '/gallery' }) %>
    <div class="content">
      <div class="page gallery-page">
        <%
          var collQ = activeCollection ? ('&collection=' + activeCollection.id) : '';
          var sortQ = activeCollection ? ('&collection=' + activeCollection.id) : (favMode ? '&favourites=1' : '');
          var heading = activeCollection ? activeCollection.name : (favMode ? 'Favourites' : 'All media');
          var thumb = function (id) { return '/gallery/' + id + '/raw?w=640'; };
          var heartSvg = '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>';
          var playSvg = '<svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>';
          var checkSvg = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
          var dlSvg = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14"/></svg>';
          var coverCells = function (rows) {
            var out = '';
            for (var i = 0; i < 3; i++) {
              out += rows[i] ? '<img src="' + thumb(rows[i].id) + '" alt="" loading="lazy">' : '<span class="g-cv-empty"></span>';
            }
            return out;
          };
        %>

        <% if (assignMode) { %>
          <div class="g-head">
            <div>
              <h2 class="g-title">Choose media for “<%= activeCollection.name %>”</h2>
              <p class="g-sub">Tap to select. Media already in this collection start selected — tap again to take them out.</p>
            </div>
          </div>
          <div class="g-selbar" id="assignBar">
            <span class="g-selcount" id="assignCount"></span>
            <div class="g-selactions">
              <a class="g-selbtn" href="/gallery?order=<%= order %><%= collQ %>">Cancel</a>
              <button type="button" class="g-selbtn primary" id="assignSave">Save</button>
            </div>
          </div>
        <% } else { %>

          <section class="g-colls" aria-label="Collections">
            <a class="g-coll" href="/gallery?order=<%= order %>" <%- !activeCollection && !favMode ? 'aria-current="page"' : '' %>>
              <span class="g-cv"><%- coverCells(covers.all) %></span>
              <span class="g-coll-name">All media</span>
              <span class="g-coll-count"><%= allCount.toLocaleString('en-US') %></span>
            </a>
            <a class="g-coll" href="/gallery?order=<%= order === 'fav' ? 'newest' : order %>&favourites=1" <%- favMode ? 'aria-current="page"' : '' %>>
              <span class="g-cv"><%- coverCells(covers.fav) %></span>
              <span class="g-coll-name">Favourites</span>
              <span class="g-coll-count"><%= favCount.toLocaleString('en-US') %></span>
            </a>
            <% collections.forEach(function(c){ %>
              <a class="g-coll" href="/gallery?order=<%= order %>&collection=<%= c.id %>" <%- activeCollection && activeCollection.id === c.id ? 'aria-current="page"' : '' %>>
                <span class="g-cv"><%- coverCells(covers[c.id] || []) %></span>
                <span class="g-coll-name"><%= c.name %></span>
                <span class="g-coll-count"><%= (collectionCounts[c.id] || 0).toLocaleString('en-US') %></span>
              </a>
            <% }) %>
            <button type="button" class="g-coll g-coll-new"
                    data-create-dialog
                    data-title="New collection"
                    data-label="Collection name"
                    data-existing="<%= JSON.stringify(collections.map(function(c){ return c.name; })) %>"
                    data-action="/gallery/collections">
              <span class="g-cv g-cv-new" aria-hidden="true">+</span>
              <span class="g-coll-name">New collection</span>
              <span class="g-coll-count">&nbsp;</span>
            </button>
          </section>

          <div class="g-head">
            <div>
              <h2 class="g-title"><%= heading %> <span class="g-count"><%= total.toLocaleString('en-US') %> <%= total === 1 ? 'item' : 'items' %></span></h2>
            </div>
            <div class="g-tools">
              <nav class="g-sort" aria-label="Sort">
                <% if (!favMode) { %><a href="/gallery?order=fav<%= sortQ %>" class="g-pill" <%- order === 'fav' ? 'aria-current="true"' : '' %>>Favourites first</a><% } %>
                <a href="/gallery?order=newest<%= sortQ %>" class="g-pill" <%- order === 'newest' ? 'aria-current="true"' : '' %>>Newest</a>
                <a href="/gallery?order=oldest<%= sortQ %>" class="g-pill" <%- order === 'oldest' ? 'aria-current="true"' : '' %>>Oldest</a>
              </nav>
              <span class="g-divider" aria-hidden="true"></span>
              <% if (images.length) { %><button type="button" class="g-pill" id="gallerySelectBtn">Select</button><% } %>
              <% if (activeCollection) { %>
                <a class="g-pill" href="/gallery?order=<%= order %><%= collQ %>&assign=1">Choose media</a>
                <form action="/gallery/collections/<%= activeCollection.id %>/delete" method="post" class="g-inline">
                  <button type="submit" class="g-pill g-pill-quiet"
                          data-confirm
                          data-title="Delete this collection?"
                          data-body="“<%= activeCollection.name %>” is removed, but its photos and videos stay in All media.">Delete collection</button>
                </form>
              <% } %>
              <span id="galleryProgress" class="g-progress" hidden></span>
              <button type="button" class="g-pill g-pill-primary" id="galleryUploadBtn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Add media
              </button>
            </div>
          </div>

          <div class="g-selbar" id="gallerySelectBar" hidden>
            <span class="g-selcount" id="gallerySelectCount">0 selected</span>
            <div class="g-selactions">
              <% if (collections.length && !activeCollection) { %>
                <button type="button" class="g-selbtn" id="gallerySelectAssign">Add to collection</button>
              <% } %>
              <button type="button" class="g-selbtn" id="gallerySelectDownload">Download</button>
              <button type="button" class="g-selbtn danger" id="gallerySelectDelete">Delete</button>
              <button type="button" class="g-selbtn ghost" id="gallerySelectCancel">Done</button>
            </div>
          </div>
        <% } %>

        <input type="file" id="galleryInput" accept="image/*,video/*" multiple hidden>

        <div class="gallery-grid g-masonry <%= assignMode ? 'select-mode' : '' %>" id="galleryGrid" data-order="<%= order %>"
             data-collection="<%= activeCollection ? activeCollection.id : '' %>"
             data-collections="<%- JSON.stringify(collections.map(function(c){ return { id: c.id, name: c.name }; })).replace(/"/g, '&quot;') %>"
             <% if (assignMode) { %>data-assign="1"<% } %><% if (favMode) { %> data-fav="1"<% } %>>
          <% images.forEach(function(img){ %>
            <% var inColl = assignMode && img.collection_id === activeCollection.id; %>
            <% var isVideo = (img.mime || '').startsWith('video/'); %>
            <div class="gallery-tile <%= inColl ? 'selected' : '' %>" data-id="<%= img.id %>"<% if (img.width && img.height) { %> data-ar="<%= (img.width / img.height).toFixed(4) %>"<% } %>>
              <div class="g-media">
                <% if (isVideo) { %>
                  <video muted playsinline preload="none" data-full="/gallery/<%= img.id %>/raw"></video>
                  <span class="media-play"><%- playSvg %>Video</span>
                <% } else { %>
                  <img src="<%= thumb(img.id) %>" data-full="/gallery/<%= img.id %>/raw" alt="<%= img.file_name || '' %>" loading="lazy">
                <% } %>
              </div>
              <span class="tile-check" aria-hidden="true"><%- checkSvg %></span>
              <% if (!assignMode) { %>
                <button type="button" class="gallery-fav <%= img.is_favourite ? 'faved' : '' %>" aria-label="Favourite" aria-pressed="<%= img.is_favourite ? 'true' : 'false' %>"><%- heartSvg %></button>
                <div class="g-foot">
                  <% if (img.file_name) { %><span class="tile-name" title="<%= img.file_name %>"><%= img.file_name %></span><% } else { %><span></span><% } %>
                  <a class="g-dl" href="/gallery/<%= img.id %>/raw?download=1" download aria-label="Download"><%- dlSvg %></a>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>

        <% /* Assign mode shows everything at once (its Save posts the whole
              selection), so it never paginates. */ %>
        <% if (!assignMode && totalPages > 1) { %>
          <%
            var gBase = '/gallery?order=' + order
              + (activeCollection ? ('&collection=' + activeCollection.id) : '')
              + (favMode ? '&favourites=1' : '') + '&page=';
            var qs = function(p){ return gBase + p; };
          %>
          <%- include('partials/pager', { page: page, totalPages: totalPages, qs: qs }) %>
          <div class="pager-info">Page <%= page %> of <%= totalPages %> · <%= total.toLocaleString('en-US') %> <%= total === 1 ? 'item' : 'items' %></div>
        <% } %>

        <div class="empty g-empty" id="galleryEmpty" <%= images.length ? 'hidden' : '' %>>
          <div class="et"><%= favMode ? 'No favourites yet' : (activeCollection ? ('Nothing in “' + activeCollection.name + '” yet') : 'No photos or videos yet') %></div>
          <div class="eh"><%= favMode ? 'Tap the heart on any photo to keep it here.' : (activeCollection ? 'Use Add media while this collection is open, or Choose media to bring some in.' : 'Use Add media to upload photos and videos.') %></div>
        </div>

      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
