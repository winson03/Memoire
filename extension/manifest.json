{
  "manifest_version": 3,
  "name": "Save to Mémoire",
  "version": "1.0.3",
  "description": "Save photos and videos from X, Patreon and other sites straight into your private Mémoire library.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Save this page to Mémoire", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["storage", "contextMenus", "alarms"],
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://pro.x.com/*"], "js": ["common.js", "content-x.js"], "run_at": "document_idle" },
    { "matches": ["https://www.patreon.com/*", "https://patreon.com/*"], "js": ["common.js", "content-patreon.js"], "run_at": "document_idle" }
  ]
}
